{
	"name": "gnome-player",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "GNOME panel buttons for one chosen MPRIS media player.",
	"scripts": {
		"build": "bun run typecheck && bun scripts/build.ts",
		"package": "bun run build && bun scripts/package.ts",
		"install:extension": "bun run package && bun scripts/install.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test src"
	},
	"devDependencies": {
		"@girs/gjs": "4.0.0-beta.12",
		"@girs/gnome-shell": "46.0.2",
		"bun-types": "1.4.2",
		"typescript": "5.9.3"
	}
}
