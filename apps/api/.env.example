# development | test | production — production is what switches the Telegram
# bot from long polling to a registered webhook (see TELEGRAM_WEBHOOK_SECRET below).
NODE_ENV=development

# Optional. trace | debug | info | warn | error | fatal — defaults to "info".
LOG_LEVEL=info

DB_DATA_PATH=/path/to/postgres/data
DATABASE_URL=postgres://user:password@localhost:5432/my_time
JWT_SECRET=bla-bla
API_URL=http://localhost:3000
FRONTEND_WEB_URL=http://localhost:5173

# Required. Permesso status checker — the government portal the practice
# number is submitted to. Automatic check hours are configured per-user from
# the Permesso Status page, not here.
PERMESSO_WEBSITE_URL=https://example.com

# Required. Telegram bot token from @BotFather.
# Users link their account per-user from the Permesso Status page — no chat ID here.
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Required when NODE_ENV=production: Telegram webhook updates are authenticated
# via this shared secret, sent back as the X-Telegram-Bot-Api-Secret-Token header.
# Generate with `openssl rand -hex 32`. Unused outside production (long polling).
TELEGRAM_WEBHOOK_SECRET=

GRAFANA_ADMIN_USER=***
GRAFANA_ADMIN_PASSWORD=***
# Public hostname Grafana is served on (used for both routing in Coolify and
# Grafana's own GF_SERVER_ROOT_URL/GF_SERVER_DOMAIN — no scheme, no path).
GRAFANA_DOMAIN=grafana-my-time.nazarit.com