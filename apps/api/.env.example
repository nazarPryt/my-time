# development | test | production — production is what switches the Telegram
NODE_ENV=development

DB_DATA_PATH=/path/to/postgres/data
DATABASE_URL=postgres://user:password@localhost:5432/my_time
JWT_SECRET=bla-bla
API_URL=http://localhost:3000
FRONTEND_WEB_URL=http://localhost:5173

# Permesso status checker — the government portal the practice number is submitted to.
# Automatic check hours are configured per-user from the Permesso Status page, not here.
PERMESSO_WEBSITE_URL=https://example.com

# Telegram bot token from @BotFather (leave unset to disable Telegram notifications).
# Users link their account per-user from the Permesso Status page — no chat ID here.
TELEGRAM_BOT_TOKEN=

# Required when NODE_ENV=production: Telegram webhook updates are authenticated
# via this shared secret, sent back as the X-Telegram-Bot-Api-Secret-Token header.
# Generate with `openssl rand -hex 32`. Unused outside production (long polling).
TELEGRAM_WEBHOOK_SECRET=