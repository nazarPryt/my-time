{
	"name": "api",
	"version": "1.0.50",
	"scripts": {
		"test": "bun test src --env-file .env.test",
		"test:db:up": "docker compose -f ../../docker-compose.test.yml up -d --wait",
		"test:db:down": "docker compose -f ../../docker-compose.test.yml down",
		"test:ci": "bun run test:db:up && bun test src --env-file .env.test; bun run test:db:down",
		"dev": "bun run --watch src/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@elysiajs/cors": "1.4.2",
		"@elysiajs/jwt": "1.4.2",
		"contracts": "workspace:*",
		"croner": "10.0.1",
		"date-fns": "4.4.0",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"elysia": "1.4.30",
		"jose": "6.2.12",
		"node-telegram-bot-api": "2.1.0",
		"p-limit": "7.3.2",
		"pino": "10.3.1",
		"postgres": "3.4.9",
		"puppeteer": "25.10.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@elysiajs/eden": "1.4.9",
		"bun-types": "1.4.2",
		"drizzle-kit": "0.31.10",
		"pino-pretty": "13.1.3",
		"typescript": "7.0.2"
	},
	"module": "src/index.js"
}
