{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"types": [],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"contracts": ["../../contracts/src/index.ts"],
			"@/*": ["./src/*"],
			"@my-time/session-sync": ["../../packages/session-sync/src/index.ts"]
		}
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
