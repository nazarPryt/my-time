{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./*"],
			"api": ["../../apps/api/src/public.ts"],
			"@my-time/contracts": ["../../packages/contracts/src/index.ts"],
			"@my-time/client-features": [
				"../../packages/client-features/src/index.ts"
			],
			"@my-time/client-features/workout": [
				"../../packages/client-features/src/workout/index.ts"
			]
		}
	},
	"references": [
		{ "path": "../../apps/api" },
		{ "path": "../../packages/contracts" }
	],
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
