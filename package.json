{
	"name": "my-time-monorepo",
	"version": "0.5.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"apps/extensions/browser",
		"apps/extensions/gnome/*",
		"packages/*"
	],
	"scripts": {
		"dev": "./scripts/ensure-docker.sh && ./scripts/ensure-env.sh && bun run docker:db && bun --filter api dev & bun --filter web dev & bun --filter english-quiz dev & wait",
		"web:dev": "bun --filter web dev",
		"web:build": "bun --filter web build",
		"quiz:dev": "bun --filter english-quiz dev",
		"quiz:build": "bun --filter english-quiz build",
		"api:dev": "bun --filter api dev",
		"extension:dev": "bun --filter extension dev",
		"extension:build": "bun --filter extension build",
		"extension:package": "./scripts/package-extension.sh",
		"gnome-time-tracker:build": "bun --filter gnome-time-tracker build",
		"gnome-time-tracker:package": "bun --filter gnome-time-tracker package",
		"gnome-time-tracker:web-package": "bun run gnome-time-tracker:package && cp apps/extensions/gnome/time-tracker/build/my-time@my-time.local.shell-extension.zip apps/web/public/",
		"gnome-time-tracker:install": "bun --filter gnome-time-tracker install:extension",
		"gnome-time-tracker:update": "bun apps/extensions/gnome/time-tracker/scripts/update.ts",
		"gnome-player:build": "bun --filter gnome-player build",
		"gnome-player:package": "bun --filter gnome-player package",
		"gnome-player:install": "bun --filter gnome-player install:extension",
		"graph": "bun scripts/graph/index.ts",
		"ci:local": "bun scripts/ci-local.ts",
		"release": "bun scripts/release/release.ts",
		"release:check": "bun scripts/release/release-check.ts",
		"test:scripts": "bun test scripts",
		"lint:check": "biome check .",
		"lint:fix": "biome check --write --unsafe . && biome format --write .",
		"docker:build": "docker compose --env-file ./apps/api/.env build",
		"docker:up": "docker compose --env-file ./apps/api/.env up -d",
		"docker:down": "docker compose --env-file ./apps/api/.env down",
		"docker:db": "docker compose --env-file ./apps/api/.env up -d --wait db",
		"docker:start": "docker compose --env-file ./apps/api/.env start",
		"docker:stop": "docker compose --env-file ./apps/api/.env stop",
		"docker:logs": "docker compose --env-file ./apps/api/.env logs -f",
		"docker:prune": "docker builder prune -f --filter until=168h",
		"test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
		"test:db:down": "docker compose -f docker-compose.test.yml down",
		"test:web": "bun --filter web test",
		"test:api": "bun --filter api test",
		"test:api:ci": "bun run test:db:up && bun --filter api test; bun run test:db:down",
		"test:web:e2e": "bun --filter web test:e2e",
		"test:web:e2e:ui": "bun --filter web test:e2e:ui",
		"test:web:e2e:extension": "bun --filter web test:e2e:extension",
		"test:web:e2e:integration": "bun scripts/e2e-integration.ts"
	},
	"overrides": {
		"@girs/gjs": "4.0.0-beta.12",
		"@girs/gobject-2.0": "2.80.3-4.0.0-beta.12",
		"@girs/gio-2.0": "2.80.3-4.0.0-beta.12",
		"@girs/glib-2.0": "2.80.3-4.0.0-beta.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"chokidar": "^5.0.0",
		"sharp": "^0.34.5",
		"ts-morph": "^28.0.0"
	}
}
