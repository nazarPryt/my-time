						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (task) (label_replace(label_replace(increase(job_duration_seconds_sum[1h]), \"task\", \"$1\", \"job\", \"(.*)\"), \"task\", \"$1\", \"exported_job\", \"(.+)\")) / sum by (task) (label_replace(label_replace(increase(job_duration_seconds_count[1h]), \"task\", \"$1\", \"job\", \"(.*)\"), \"task\", \"$1\", \"exported_job\", \"(.+)\"))",
