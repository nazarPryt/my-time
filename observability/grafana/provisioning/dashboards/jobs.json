		{
			"type": "timeseries",
			"title": "Permesso checks by trigger and result",
			"description": "Permit-portal checks per hour. scheduled = the hourly job, manual = a user pressed 'check now'. Failures usually mean the portal is down or changed its HTML.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (trigger, result) (increase(permesso_checks_total[$__interval]))",
					"legendFormat": "{{trigger}} {{result}}",
					"editorMode": "code",
					"range": true,
					"instant": false
				}
			],
			"fieldConfig": {
				"defaults": {
