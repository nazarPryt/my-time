				"uid": "prometheus"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (task) (label_replace(label_replace(increase(job_runs_total{result=\"failure\"}[$__range]), \"task\", \"$1\", \"job\", \"(.*)\"), \"task\", \"$1\", \"exported_job\", \"(.+)\"))",
					"legendFormat": "{{task}}",
