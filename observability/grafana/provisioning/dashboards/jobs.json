		{
			"type": "stat",
			"title": "Time since last success",
			"description": "How long ago each background job last finished successfully. Right after an API restart this resets to the restart time, so it never looks stale only because of a deploy. permesso.scheduled-checks runs hourly: amber after 2 h, red after 3 h. auth.purge-expired-refresh-tokens runs weekly (Sunday 03:00): amber after 7.5 days, red after 8 days.",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "time() - max by (task) (label_replace(label_replace(job_last_success_timestamp_seconds, \"task\", \"$1\", \"job\", \"(.*)\"), \"task\", \"$1\", \"exported_job\", \"(.+)\"))",
					"legendFormat": "{{task}}",
					"editorMode": "code",
					"range": false,
					"instant": true
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "dtdurations",
					"color": {
						"mode": "thresholds"
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							},
							{
								"color": "#EAB839",
								"value": 7200
							},
							{
								"color": "red",
								"value": 10800
							}
						]
					},
					"mappings": [],
					"noValue": "no data yet"
				},
				"overrides": [
					{
						"matcher": {
							"id": "byName",
							"options": "auth.purge-expired-refresh-tokens"
						},
						"properties": [
							{
								"id": "thresholds",
								"value": {
									"mode": "absolute",
									"steps": [
										{
											"color": "green",
											"value": null
										},
										{
											"color": "#EAB839",
											"value": 648000
										},
										{
											"color": "red",
											"value": 691200
										}
									]
								}
							}
						]
					}
				]
			},
			"options": {
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"colorMode": "background",
				"graphMode": "none",
				"textMode": "auto",
				"justifyMode": "auto",
				"orientation": "auto",
				"wideLayout": true,
				"showPercentChange": false
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 12,
				"h": 5
			},
			"id": 2
		},
		{
			"type": "stat",
			"title": "Job failures",
