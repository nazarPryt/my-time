{
	"uid": "my-time-logs",
	"title": "Logs explorer",
	"description": "Search any service's logs by service, level, free text or request id.",
	"tags": ["my-time", "logs"],
	"timezone": "browser",
	"schemaVersion": 40,
	"version": 1,
	"editable": true,
	"graphTooltip": 1,
	"liveNow": false,
	"refresh": "1m",
	"time": {
		"from": "now-24h",
		"to": "now"
	},
	"timepicker": {},
	"fiscalYearStartMonth": 0,
	"links": [
		{
			"title": "my-time dashboards",
			"type": "dashboards",
			"tags": ["my-time"],
			"asDropdown": true,
			"includeVars": false,
			"keepTime": true,
			"targetBlank": false,
			"icon": "external link",
			"tooltip": "",
			"url": ""
		}
	],
	"templating": {
		"list": [
			{
				"name": "service",
				"label": "Service",
				"type": "query",
				"datasource": {
					"type": "loki",
					"uid": "loki"
				},
				"query": {
					"label": "service",
					"stream": "",
					"type": 1,
					"refId": "LokiVariableQueryEditor-VariableQuery"
				},
				"definition": "label_values(service)",
				"refresh": 2,
				"sort": 1,
				"multi": true,
				"includeAll": true,
				"allValue": ".+",
				"current": {
					"selected": true,
					"text": ["All"],
					"value": ["$__all"]
				},
				"options": [],
				"description": "Compose service the logs come from (api, web, db, …)."
			},
			{
				"name": "level",
				"label": "Level",
				"type": "custom",
				"query": "trace,debug,info,warn,error,fatal",
				"multi": true,
				"includeAll": true,
				"allValue": ".*",
				"current": {
					"selected": true,
					"text": ["All"],
					"value": ["$__all"]
				},
				"options": [
					{
						"selected": true,
						"text": "All",
						"value": "$__all"
					},
					{
						"selected": false,
						"text": "trace",
						"value": "trace"
					},
					{
						"selected": false,
						"text": "debug",
						"value": "debug"
					},
					{
						"selected": false,
						"text": "info",
						"value": "info"
					},
					{
						"selected": false,
						"text": "warn",
						"value": "warn"
					},
					{
						"selected": false,
						"text": "error",
						"value": "error"
					},
					{
						"selected": false,
						"text": "fatal",
						"value": "fatal"
					}
				],
				"description": "Only the api (JSON logs) has a level; picking a level hides services without one."
			},
			{
				"name": "search",
				"label": "Search text",
				"type": "textbox",
				"query": "",
				"current": {
					"selected": false,
					"text": "",
					"value": ""
				},
				"options": [
					{
						"selected": true,
						"text": "",
						"value": ""
					}
				],
				"description": "Case-insensitive plain text to look for in the log line."
			},
			{
				"name": "requestId",
				"label": "Request id",
				"type": "textbox",
				"query": "",
				"current": {
					"selected": false,
					"text": "",
					"value": ""
				},
				"options": [
					{
						"selected": true,
						"text": "",
						"value": ""
					}
				],
				"description": "Paste the X-Request-Id of a failing request to see all of its lines."
			}
		]
	},
	"annotations": {
		"list": [
			{
				"builtIn": 1,
				"datasource": {
					"type": "grafana",
					"uid": "-- Grafana --"
				},
				"enable": true,
				"hide": true,
				"iconColor": "rgba(0, 211, 255, 1)",
				"name": "Annotations & Alerts",
				"type": "dashboard"
			},
			{
				"name": "Deploys",
				"datasource": {
					"type": "loki",
					"uid": "loki"
				},
				"enable": true,
				"iconColor": "purple",
				"expr": "{service=\"api\"} |= \"server is up and running\" | json",
				"target": {
					"refId": "Anno",
					"expr": "{service=\"api\"} |= \"server is up and running\" | json"
				},
				"titleFormat": "Deploy",
				"textFormat": "API started, version {{version}}",
				"tagKeys": "version",
				"instant": false
			}
		]
	},
	"panels": [
		{
			"type": "timeseries",
			"title": "Log volume by level",
			"description": "Matching log lines per time bucket, by level. Lines from services without a level (nginx, Postgres, …) show as 'no level'. A red/orange spike points you to when something broke.",
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "loki",
						"uid": "loki"
					},
					"expr": "sum by (level) (count_over_time({service=~\"$service\", level=~\"$level\"} |~ `(?i)${search:regex}` |= `$requestId` | label_format level=`{{ if .level }}{{ .level }}{{ else }}no level{{ end }}` [$__auto]))",
					"editorMode": "code",
					"queryType": "range",
					"legendFormat": "{{level}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "palette-classic"
					},
					"custom": {
						"drawStyle": "bars",
						"lineWidth": 1,
						"fillOpacity": 70,
						"gradientMode": "none",
						"showPoints": "never",
						"spanNulls": false,
						"axisSoftMin": 0,
						"lineInterpolation": "linear",
						"stacking": {
							"mode": "normal",
							"group": "A"
						},
						"thresholdsStyle": {
							"mode": "off"
						},
						"insertNulls": false
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							}
						]
					},
					"decimals": 0
				},
				"overrides": [
					{
						"matcher": {
							"id": "byName",
							"options": "trace"
						},
						"properties": [
							{
								"id": "color",
								"value": {
									"mode": "fixed",
									"fixedColor": "#8F8F8F"
								}
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "debug"
						},
						"properties": [
							{
								"id": "color",
								"value": {
									"mode": "fixed",
									"fixedColor": "#8AB8FF"
								}
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "info"
						},
						"properties": [
							{
								"id": "color",
								"value": {
									"mode": "fixed",
									"fixedColor": "green"
								}
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "warn"
						},
						"properties": [
							{
								"id": "color",
								"value": {
									"mode": "fixed",
									"fixedColor": "#EAB839"
								}
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "error"
						},
						"properties": [
							{
								"id": "color",
								"value": {
									"mode": "fixed",
									"fixedColor": "red"
								}
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "fatal"
						},
						"properties": [
							{
								"id": "color",
								"value": {
									"mode": "fixed",
									"fixedColor": "dark-red"
								}
							}
						]
					},
					{
						"matcher": {
							"id": "byName",
							"options": "no level"
						},
						"properties": [
							{
								"id": "color",
								"value": {
									"mode": "fixed",
									"fixedColor": "#B0B0B0"
								}
							}
						]
					}
				]
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true,
					"calcs": []
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 14,
				"h": 8
			},
			"id": 1
		},
		{
			"type": "timeseries",
			"title": "Log volume by service",
			"description": "Matching log lines per time bucket, by service.",
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "loki",
						"uid": "loki"
					},
					"expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"$level\"} |~ `(?i)${search:regex}` |= `$requestId` [$__auto]))",
					"editorMode": "code",
					"queryType": "range",
					"legendFormat": "{{service}}"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "palette-classic"
					},
					"custom": {
						"drawStyle": "bars",
						"lineWidth": 1,
						"fillOpacity": 70,
						"gradientMode": "none",
						"showPoints": "never",
						"spanNulls": false,
						"axisSoftMin": 0,
						"lineInterpolation": "linear",
						"stacking": {
							"mode": "normal",
							"group": "A"
						},
						"thresholdsStyle": {
							"mode": "off"
						},
						"insertNulls": false
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{
								"color": "green",
								"value": null
							}
						]
					},
					"decimals": 0
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true,
					"calcs": []
				},
				"tooltip": {
					"mode": "multi",
					"sort": "desc"
				}
			},
			"gridPos": {
				"x": 14,
				"y": 0,
				"w": 10,
				"h": 8
			},
			"id": 2
		},
		{
			"type": "logs",
			"title": "Logs",
			"description": "Matching log lines, newest first. Click a line to see all its fields and labels. Use the variables at the top to narrow down; leave them empty to see everything.",
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "loki",
						"uid": "loki"
					},
					"expr": "{service=~\"$service\", level=~\"$level\"} |~ `(?i)${search:regex}` |= `$requestId`",
					"editorMode": "code",
					"queryType": "range",
					"maxLines": 1000
				}
			],
			"options": {
				"showTime": true,
				"showLabels": false,
				"showCommonLabels": false,
				"wrapLogMessage": true,
				"prettifyLogMessage": false,
				"enableLogDetails": true,
				"dedupStrategy": "none",
				"sortOrder": "Descending"
			},
			"gridPos": {
				"x": 0,
				"y": 8,
				"w": 24,
				"h": 22
			},
			"id": 3
		}
	]
}
